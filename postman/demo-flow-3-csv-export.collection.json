{
  "info": {
    "_postman_id": "a1b2c3d4-0003-4000-8000-demo-flow-0003",
    "name": "Demo Flow 3 — CSV Data Export Pipeline",
    "description": "User Story: An analyst ingests market data then exports it in CSV format for downstream processing (e.g. Excel, Python pandas). Multiple export filters are demonstrated.\n\nSteps:\n  1. Log in → capture accessToken\n  2. Create dataset & ingest TSLA + AMZN events for Feb 2026\n  3. Export all events as CSV (full dataset)\n  4. Export first 10 events in chronological order (paginated)\n  5. Export only TSLA events (company-filtered)\n  6. Export only AMZN events within a specific date range\n  7. Update dataset name\n  8. Delete dataset (cleanup)\n\nRun with Newman:\n  npx newman run postman/demo-flow-3-csv-export.collection.json \\\n    --env-var apiId=<YOUR_API_ID>",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "apiId",       "value": "77e5a0c0" },
    { "key": "baseUrl",     "value": "http://localhost:4566/_aws/execute-api/{{apiId}}" },
    { "key": "email",       "value": "demo.analyst@example.com" },
    { "key": "password",    "value": "DemoP@ssw0rd1!" },
    { "key": "accessToken", "value": "" },
    { "key": "datasetId",   "value": "" }
  ],
  "item": [
    {
      "name": "1) Log In",
      "description": "Authenticate and capture the Cognito access token.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('login: 200 OK', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.collectionVariables.set('accessToken', json.accessToken);",
              "pm.test('accessToken captured', function () {",
              "  pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/v1/auth/login"
      }
    },
    {
      "name": "2a) Create Dataset — Export Demo",
      "description": "Create a named dataset for the export demonstration.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('create dataset: 201 Created', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.collectionVariables.set('datasetId', json.dataset_id);",
              "pm.test('datasetId captured', function () { pm.expect(json.dataset_id).to.be.a('string').and.not.empty; });",
              "console.log('Dataset created:', json.dataset_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Export Demo — TSLA & AMZN\",\n  \"description\": \"Dataset created for CSV export demonstration\"\n}"
        },
        "url": "{{baseUrl}}/v1/datasets"
      }
    },
    {
      "name": "2b) Ingest Events — TSLA + AMZN, Feb 2026",
      "description": "Ingest daily OHLC data for Tesla and Amazon from Yahoo Finance.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('fetch events: 200 OK', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('events ingested', function () { pm.expect(json.count).to.be.above(0); });",
              "console.log('Ingested', json.count, 'events.');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"symbols\": [\"TSLA\", \"AMZN\"],\n  \"exchange\": \"XNAS\",\n  \"date_from\": \"2026-02-01\",\n  \"date_to\": \"2026-02-28\"\n}"
        },
        "url": "{{baseUrl}}/v1/datasets/{{datasetId}}/events/fetch"
      }
    },
    {
      "name": "3) Export All Events (Full CSV)",
      "description": "Download a CSV file containing every event in the dataset. The response is plain text/csv suitable for saving to a file.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('export: 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('content-type is text/csv', function () {",
              "  pm.expect(pm.response.headers.get('content-type')).to.include('text/csv');",
              "});",
              "var body = pm.response.text();",
              "pm.test('CSV has header row', function () {",
              "  pm.expect(body).to.include('symbol');",
              "  pm.expect(body).to.include('open');",
              "  pm.expect(body).to.include('close');",
              "});",
              "var lines = body.trim().split('\\n');",
              "pm.test('CSV has data rows', function () {",
              "  pm.expect(lines.length).to.be.above(1);",
              "});",
              "console.log('CSV rows (inc. header):', lines.length);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/v1/datasets/{{datasetId}}/export"
      }
    },
    {
      "name": "4) Export — First 10 Events (Chronological)",
      "description": "Export only the 10 oldest events, ordered ascending. Useful for building time-series pipelines that process data in batches.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('limited export: 200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('content-type is text/csv', function () {",
              "  pm.expect(pm.response.headers.get('content-type')).to.include('text/csv');",
              "});",
              "var lines = pm.response.text().trim().split('\\n');",
              "pm.test('at most 11 lines (1 header + up to 10 data rows)', function () {",
              "  pm.expect(lines.length).to.be.at.most(11);",
              "});",
              "console.log('Limited CSV rows (inc. header):', lines.length);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/v1/datasets/{{datasetId}}/export?limit=10&order=ASC",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "datasets", "{{datasetId}}", "export"],
          "query": [
            { "key": "limit", "value": "10" },
            { "key": "order", "value": "ASC" }
          ]
        }
      }
    },
    {
      "name": "5) Export — TSLA Events Only",
      "description": "Export events filtered to Tesla only. Demonstrates the 'companies' query parameter on the export endpoint.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('company-filtered export: 200 OK', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.text();",
              "var lines = body.trim().split('\\n');",
              "pm.test('CSV has data rows', function () { pm.expect(lines.length).to.be.above(1); });",
              "pm.test('all data rows belong to TSLA', function () {",
              "  lines.slice(1).forEach(function(line) {",
              "    if (line.trim()) pm.expect(line).to.include('TSLA');",
              "  });",
              "});",
              "console.log('TSLA-only rows (inc. header):', lines.length);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/v1/datasets/{{datasetId}}/export?companies=TSLA",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "datasets", "{{datasetId}}", "export"],
          "query": [
            { "key": "companies", "value": "TSLA" }
          ]
        }
      }
    },
    {
      "name": "6) Export — AMZN, Second Half of Feb 2026",
      "description": "Export Amazon events from the second half of February. Demonstrates combining company and date-range filters on export.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('date+company filtered export: 200 OK', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.text();",
              "var lines = body.trim().split('\\n');",
              "pm.test('has header and at least one data row', function () {",
              "  pm.expect(lines.length).to.be.above(1);",
              "});",
              "console.log('AMZN (15-28 Feb) rows (inc. header):', lines.length);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": {
          "raw": "{{baseUrl}}/v1/datasets/{{datasetId}}/export?companies=AMZN&start_date=2026-02-15&end_date=2026-02-28",
          "host": ["{{baseUrl}}"],
          "path": ["v1", "datasets", "{{datasetId}}", "export"],
          "query": [
            { "key": "companies",   "value": "AMZN" },
            { "key": "start_date",  "value": "2026-02-15" },
            { "key": "end_date",    "value": "2026-02-28" }
          ]
        }
      }
    },
    {
      "name": "7) Update Dataset Name",
      "description": "Rename the dataset to reflect that it has been exported. Demonstrates the PUT update endpoint.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('update dataset: 200 OK', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('name was updated', function () {",
              "  pm.expect(json.dataset_id).to.equal(pm.collectionVariables.get('datasetId'));",
              "});",
              "console.log('Dataset renamed successfully.');"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Export Demo — TSLA & AMZN (exported)\",\n  \"description\": \"Exported to CSV on 2026-03-02\"\n}"
        },
        "url": "{{baseUrl}}/v1/datasets/{{datasetId}}"
      }
    },
    {
      "name": "8) Delete Dataset (Cleanup)",
      "description": "Remove the demo dataset and all its events from storage.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('delete dataset: 200 OK', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('deletion count is 1', function () { pm.expect(json.count).to.equal(1); });",
              "console.log('Dataset deleted. Count:', json.count);"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/v1/datasets/{{datasetId}}"
      }
    }
  ]
}
