{
  "info": {
    "_postman_id": "7e7d2c1f-2f14-4d0e-9e38-6e1d6b1d9c3e",
    "name": "Financial Events API (LocalStack) - Collection + Retrieval",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "apiId", "value": "77e5a0c0" },
    { "key": "baseUrl", "value": "http://localhost:4566/_aws/execute-api/{{apiId}}" },
    { "key": "datasetId", "value": "" },
    { "key": "email", "value": "testuser@example.com" },
    { "key": "password", "value": "TestP@ssw0rd1!" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "0) Auth - Signup",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201 or 409', function () {",
              "  pm.expect([201, 400, 409]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "content-type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/v1/auth/signup"
      }
    },
    {
      "name": "0b) Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.collectionVariables.set('accessToken', json.accessToken);",
              "pm.test('accessToken captured', function () {",
              "  pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "content-type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": "{{baseUrl}}/v1/auth/login"
      }
    },
    {
      "name": "1) Create dataset",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 201', function () { pm.response.to.have.status(201); });",
              "var json = pm.response.json();",
              "pm.collectionVariables.set('datasetId', json.dataset_id);",
              "pm.test('datasetId captured', function () { pm.expect(json.dataset_id).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "content-type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"E2E dataset\",\n  \"description\": \"created by Postman collection\"\n}"
        },
        "url": "{{baseUrl}}/v1/datasets"
      }
    },
    {
      "name": "2) Fetch events into dataset",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('count is present', function () { pm.expect(json.count).to.be.a('number'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "content-type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{accessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"symbols\": [\"AAPL.XNAS\", \"MSFT.XNAS\"],\n  \"exchange\": \"XNAS\",\n  \"date_from\": \"2026-02-01\",\n  \"date_to\": \"2026-02-02\",\n  \"sort\": \"DESC\",\n  \"limit\": 100,\n  \"offset\": 0\n}"
        },
        "url": "{{baseUrl}}/v1/datasets/{{datasetId}}/events/fetch"
      }
    },
    {
      "name": "3) List datasets (retrieval)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('is array', function () { pm.expect(json).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/v1/datasets"
      }
    },
    {
      "name": "4) Get dataset events (retrieval)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('retrieved is number', function () { pm.expect(json.retrieved).to.be.a('number'); });",
              "pm.test('events present', function () { pm.expect(json.dataset.events).to.be.an('array'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/v1/datasets/{{datasetId}}/events?limit=10&sort=time&order=ASC"
      }
    },
    {
      "name": "5) Get event stats (retrieval)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "var json = pm.response.json();",
              "pm.test('total_events is number', function () { pm.expect(json.total_events).to.be.a('number'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/v1/datasets/{{datasetId}}/events/stats"
      }
    },
    {
      "name": "6) Export CSV (retrieval)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('content-type is text/csv', function () { pm.expect(pm.response.headers.get('content-type')).to.include('text/csv'); });",
              "pm.test('has csv header line', function () { pm.expect(pm.response.text()).to.include('symbol,open,high,low,close,volume,timestamp'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/v1/datasets/{{datasetId}}/export?limit=5"
      }
    }
  ]
}
