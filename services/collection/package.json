{
  "name": "collection",
  "version": "1.0.0",
  "description": "Microservice for collecting and managing event data from external sources for the SENG3011 Team Tango project",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "src/server.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "jest",
    "tsc": "tsc --project tsconfig.json",
    "lint": "eslint 'src/**/*.{ts,js}'",
    "lint-fix": "eslint --fix 'src/**/*.{ts,js}'",
    "start": "bash -c 'set -a; source .env; set +a; ts-node -T src/server.ts'",
    "cleanup-sync-request": "pkill -f node_modules/sync-rpc/lib/worker.js > /dev/null 2>&1",
    "posttest": "npm run cleanup-sync-request || true",
    "ts-node-coverage": "nyc --reporter=text --reporter=lcov ts-node -T src/server.ts",
    "dev": "bash -c 'set -a; source .env; set +a; ts-node-dev -T src/server.ts'"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.888.0",
    "@aws-sdk/client-s3": "^3.888.0",
    "@aws-sdk/lib-dynamodb": "^3.888.0",
    "@vendia/serverless-express": "^4.12.1",
    "aws-jwt-verify": "^5.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.3.3",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "esbuild": "0.27.4",
    "eslint": "^10.0.2",
    "jest": "^30.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
